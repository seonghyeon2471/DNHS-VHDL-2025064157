  <vhdl appearance="logisim_evolution" name="sevensegment">LIBRARY ieee;
USE ieee.std_logic_1164.ALL;

ENTITY sevensegment IS
    PORT (
        en  : IN  STD_LOGIC;
        vt  : IN  STD_LOGIC_VECTOR(12 DOWNTO 0);
        seg : OUT STD_LOGIC_VECTOR(6 DOWNTO 0)
    );
END sevensegment;

ARCHITECTURE Behavioral OF sevensegment IS
BEGIN

    PROCESS(en, vt)
        VARIABLE count : INTEGER RANGE 0 TO 13;
    BEGIN

        IF en = '0' THEN
            seg &lt;= "ZZZZZZZZ";

        ELSE
            count := 0;

            FOR i IN vt'RANGE LOOP
                IF vt(i) = '1' THEN
                    count := count + 1;
                END IF;
            END LOOP;

            CASE count IS
                WHEN 0  =&gt; seg &lt;= "1111110";
                WHEN 1  =&gt; seg &lt;= "0110000";
                WHEN 2  =&gt; seg &lt;= "1101101";
                WHEN 3  =&gt; seg &lt;= "1111001";
                WHEN 4  =&gt; seg &lt;= "0110011";
                WHEN 5  =&gt; seg &lt;= "1011011";
                WHEN 6  =&gt; seg &lt;= "1011111";
                WHEN 7  =&gt; seg &lt;= "1110000";
                WHEN 8  =&gt; seg &lt;= "1111111";
                WHEN 9  =&gt; seg &lt;= "1111011";
                WHEN 10 =&gt; seg &lt;= "1110111"; -- A
                WHEN 11 =&gt; seg &lt;= "0011111"; -- b
                WHEN 12 =&gt; seg &lt;= "1001110"; -- C
                WHEN 13 =&gt; seg &lt;= "0111101"; -- d
                WHEN OTHERS =&gt; seg &lt;= "0000000";
            END CASE;

        END IF;

    END PROCESS;

END Behavioral;
</vhdl>
