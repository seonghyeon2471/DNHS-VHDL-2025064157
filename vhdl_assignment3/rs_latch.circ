  </circuit>
  <vhdl appearance="logisim_evolution" name="RS_LATCH">library IEEE;
use IEEE.STD_LOGIC_1164.ALL;

entity RS_LATCH is
    Port (
        S  : in STD_LOGIC;
        R  : in STD_LOGIC;
        Q  : out STD_LOGIC;
        Qn : out STD_LOGIC
    );
end RS_LATCH;

architecture Behavioral of RS_LATCH is
    signal q_int : STD_LOGIC := '0';
begin

    process(S, R)
    begin
        if (S = '1' and R = '1') then
            q_int &lt;= 'X';

        elsif (S = '1') then
            q_int &lt;= '1';

        elsif (R = '1') then
            q_int &lt;= '0';

        end if;
    end process;

    Q &lt;= q_int;
    Qn &lt;= not q_int;

end Behavioral;
</vhdl>
